# Identifiers for scripts/pre-merge-check.sh. Sourced by the script; every value can be overridden
# from the environment (e.g. PRE_MERGE_AVD=Pixel_Tablet_API_34 scripts/pre-merge-check.sh).
# No secrets belong here: the E2E account comes from scripts/e2e-up.sh and .maestro/scripts.

# ---- Android ----
PRE_MERGE_AVD="${PRE_MERGE_AVD:-Pixel_8}"
PRE_MERGE_ANDROID_APP_ID="${PRE_MERGE_ANDROID_APP_ID:-org.scent.project}"
PRE_MERGE_ANDROID_FONT_SCALE="${PRE_MERGE_ANDROID_FONT_SCALE:-2.0}"
# Guest RAM in MB when the script boots the emulator. Pixel_8's 2 GB default swapped heavily and
# Android restarted mid-run, so the app vanished and flows took minutes. Ignored for a reused emulator.
PRE_MERGE_EMULATOR_MEMORY="${PRE_MERGE_EMULATOR_MEMORY:-4096}"

# ---- iOS ----
# The simulator is picked by name from the newest iOS runtime; set PRE_MERGE_IOS_UDID to pin one.
PRE_MERGE_IOS_DEVICE="${PRE_MERGE_IOS_DEVICE:-iPhone 17 Pro}"
PRE_MERGE_IOS_UDID="${PRE_MERGE_IOS_UDID:-}"
PRE_MERGE_IOS_PROJECT="${PRE_MERGE_IOS_PROJECT:-iosApp/iosApp.xcodeproj}"
PRE_MERGE_IOS_SCHEME="${PRE_MERGE_IOS_SCHEME:-iosApp}"
PRE_MERGE_IOS_BUNDLE_ID="${PRE_MERGE_IOS_BUNDLE_ID:-org.scent.project.Scent}"
PRE_MERGE_IOS_APP_NAME="${PRE_MERGE_IOS_APP_NAME:-Scent.app}"
# Dynamic Type for the checks. Sign-in runs at the default size first (see .maestro/a11y/setup).
PRE_MERGE_IOS_CONTENT_SIZE="${PRE_MERGE_IOS_CONTENT_SIZE:-accessibility-large}"
PRE_MERGE_IOS_SIGN_IN_CONTENT_SIZE="${PRE_MERGE_IOS_SIGN_IN_CONTENT_SIZE:-large}"

# ---- Timing ----
PRE_MERGE_BOOT_TIMEOUT_S="${PRE_MERGE_BOOT_TIMEOUT_S:-300}"
# Tree captures: up to this many dumps, 1 s apart, until two in a row match (screen settled).
PRE_MERGE_SETTLE_ATTEMPTS="${PRE_MERGE_SETTLE_ATTEMPTS:-6}"
# iOS: retries when AXe returns an empty tree (accessibility not ready yet), 2 s apart.
PRE_MERGE_AX_READY_ATTEMPTS="${PRE_MERGE_AX_READY_ATTEMPTS:-5}"
