# --- Database (Supabase) ---
# Direct connection (port 5432) — supports session features, prepared statements
DATABASE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Pooler alternative (port 6543, PgBouncer transaction mode) — preferred on Render free tier
# DATABASE_URL=jdbc:postgresql://<project-ref>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_USER=postgres
DATABASE_PASSWORD=your-supabase-password

# --- JWT ---
JWT_SECRET=your-super-secret-key
JWT_ISSUER=fragrances-app
JWT_AUDIENCE=fragrances-users
JWT_REALM=fragrances

# --- Phase 2/3 (not yet active) ---
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# APPLE_BUNDLE_ID=com.yourcompany.scentapp

# --- Cloudflare Stream (M1: Media Pipeline) ---
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_WEBHOOK_SECRET=your-cloudflare-webhook-secret

# --- Supabase Storage (listing photos) ---
# Project URL, no trailing slash — e.g. https://<project-ref>.supabase.co
SUPABASE_URL=https://<project-ref>.supabase.co
# Service-role key. Server-side only — never ship this in the app.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Must exist as a public bucket in Supabase Storage before the first upload.
SUPABASE_STORAGE_BUCKET=listing-photos

# --- Provider modes (local development) ---
# Set to `fake` to drive the full upload state machine without a paid provider.
# Anything else (or unset) selects the real provider. Never set these in production.
# IMAGE_PROVIDER=fake
# STREAM_PROVIDER=fake
