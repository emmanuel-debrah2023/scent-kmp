{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-unverified-push.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-suppressions.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/gate-dependency-additions.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-jvm-in-commonmain.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*notion.*create.*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/validate-scent-ticket.sh"
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/ktlint-format.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "agent",
            "prompt": "Inspect the bash command that just ran. If and only if it was a successful merge of a pull request (`gh pr merge`, or a `git merge` of a feature branch into main/develop), find the Scent Notion ticket corresponding to that branch name: read the data source URL from `.claude/.scent-notion.env` (the SCENT_NOTION_DS variable), query the Tasks Tracker data source at that URL, match on the Feature Branch property, and set that ticket's Status to `Done` (verbatim). If the command was not a merge, or no ticket matches the branch, or the env file is missing, do nothing and return silently. Never create a ticket from this hook, and never set any property other than Status."
          }
        ]
      }
    ],

    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "rm -f $CLAUDE_PROJECT_DIR/.claude/.scent-gates.json"
          }
        ]
      }
    ],

    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cp $CLAUDE_PROJECT_DIR/.claude/.scent-gates.json $CLAUDE_PROJECT_DIR/.claude/.scent-gates.pre-compact.json 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
